{
  "name": "macrazer-reports",
  "private": true,
  "description": "Receives MacRazer device test reports and emails them to the maintainer.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
